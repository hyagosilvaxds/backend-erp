### 🧪 Testes de Atualização de Cliente com Endereços e Contatos

### Variáveis
@baseUrl = http://localhost:4000
@token = seu-token-jwt-aqui
@companyId = db0019dd-4dcd-46c3-aaef-66b87a58c5c2
@customerId = 30e6c969-d7b3-48a2-a5e3-a75bc0e235cc

### =================================================================
### 1️⃣ BUSCAR CLIENTE ANTES DA ATUALIZAÇÃO
### =================================================================

GET {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{token}}

### =================================================================
### 2️⃣ ATUALIZAR CLIENTE COM 1 ENDEREÇO (Principal)
### =================================================================

PATCH {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "personType": "JURIDICA",
  "active": true,
  "companyName": "Olimpus Solucoes Empresariais LTDA",
  "tradeName": "Olimpus Solucoes Empresariais",
  "cnpj": "57953546000184",
  "stateRegistration": "0050328560022",
  "stateRegistrationExempt": false,
  "taxRegime": "SIMPLES_NACIONAL",
  "addresses": [
    {
      "type": "MAIN",
      "zipCode": "39404076",
      "street": "Rua Marmelo",
      "number": "140",
      "neighborhood": "Alto Floresta",
      "city": "Montes Claros",
      "state": "MG",
      "ibgeCode": "3143302"
    }
  ]
}

