      "isPrimary": true
    },
    {
      "name": "Maria Santos",
      "role": "Financeiro",
      "email": "maria.santos@olimpus.com.br",
      "phone": "38997654321",
      "isPrimary": false
    }
  ]
}

### =================================================================
### 5️⃣ REMOVER TODOS OS ENDEREÇOS (Array vazio)
### =================================================================

PATCH {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "personType": "JURIDICA",
  "companyName": "Olimpus Solucoes Empresariais LTDA",
  "cnpj": "57953546000184",
  "addresses": []
}

### =================================================================
### 6️⃣ ATUALIZAR SEM TOCAR NOS ENDEREÇOS (não enviar campo)
### =================================================================

PATCH {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "personType": "JURIDICA",
  "companyName": "Olimpus Solucoes Empresariais LTDA - ATUALIZADO",
  "taxRegime": "LUCRO_PRESUMIDO"
}

### =================================================================
### 7️⃣ BUSCAR CLIENTE APÓS ATUALIZAÇÃO
### =================================================================

GET {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{token}}

### =================================================================
### 8️⃣ TESTE: Pessoa Física com Endereço
### =================================================================

# Primeiro, criar um cliente PF
POST {{baseUrl}}/customers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "personType": "FISICA",
  "name": "Carlos Eduardo Santos",
  "cpf": "12345678900",
  "email": "carlos@email.com",
  "phone": "38991111111",
  "addresses": [
    {
      "type": "MAIN",
      "zipCode": "39400000",
      "street": "Rua Principal",
      "number": "123",
      "neighborhood": "Centro",
      "city": "Montes Claros",
      "state": "MG",
      "ibgeCode": "3143302"
    }
  ]
}

### Depois atualizar o endereço (use o ID retornado acima)
PATCH {{baseUrl}}/customers/{id-do-cliente-pf}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "personType": "FISICA",
  "name": "Carlos Eduardo Santos",
  "cpf": "12345678900",
  "addresses": [
    {
      "type": "MAIN",
      "zipCode": "39404076",
      "street": "Rua Marmelo ATUALIZADA",
      "number": "999",
      "neighborhood": "Alto Floresta",
      "city": "Montes Claros",
      "state": "MG",
      "ibgeCode": "3143302"
    }
  ]
}

### =================================================================
### 📊 VALIDAÇÕES ESPERADAS
### =================================================================

# ✅ Teste 2: Deve criar 1 endereço
# ✅ Teste 3: Deve substituir por 3 endereços (deleta o anterior)
# ✅ Teste 4: Deve criar 1 endereço + 2 contatos
# ✅ Teste 5: Deve remover todos os endereços
# ✅ Teste 6: Deve manter endereços existentes (não enviou campo)
# ✅ Teste 7: Deve retornar cliente com addresses e contacts
# ✅ Teste 8: Deve funcionar para pessoa física também

