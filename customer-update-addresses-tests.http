### =================================================================
### 4️⃣ ATUALIZAR CLIENTE COM ENDEREÇOS E CONTATOS
### =================================================================

PATCH {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "personType": "JURIDICA",
  "companyName": "Olimpus Solucoes Empresariais LTDA",
  "tradeName": "Olimpus Solucoes Empresariais",
  "cnpj": "57953546000184",
  "taxRegime": "SIMPLES_NACIONAL",
  "email": "contato@olimpus.com.br",
  "phone": "38991234567",
  "addresses": [
    {
      "type": "MAIN",
      "zipCode": "39404076",
      "street": "Rua Marmelo",
      "number": "140",
      "neighborhood": "Alto Floresta",
      "city": "Montes Claros",
      "state": "MG",
      "ibgeCode": "3143302"
    }
  ],
  "contacts": [
    {
      "name": "João Silva",
      "role": "Gerente Comercial",
